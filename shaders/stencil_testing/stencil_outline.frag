/**
 * 片段着色器 —— 模板测试：描边专用
 *
 * ============================================================
 *  功能
 * ============================================================
 * 输出纯色片段，用于物体描边效果。
 * 与其他着色器的区别：不需要纹理、光照等计算，只要一种醒目的单色。
 *
 * ============================================================
 *  为什么是纯色？
 * ============================================================
 * 描边（Outline）效果的关键是让物体的边框可见。
 * 使用纯色（如亮黄、亮绿）在视觉上形成强烈的对比，
 * 类似建模软件（Blender/3ds Max）中的选择高亮效果。
 *
 * @version 330 core
 */
#version 330 core

out vec4 FragColor;

uniform vec3 outlineColor;  // 描边颜色（RGB），默认亮绿色

void main()
{
    FragColor = vec4(outlineColor, 1.0);
}
