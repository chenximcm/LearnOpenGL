/**
 * 片段着色器 —— 单纹理版本
 *
 * ============================================================
 *  功能
 * ============================================================
 * 从纹理坐标采样颜色，为每个像素上色。
 *
 * ============================================================
 *  输入
 * ============================================================
 * TexCoord —— 从顶点着色器传来的纹理坐标（已在三角形内插值）
 *
 * ============================================================
 *  Uniform
 * ============================================================
 * ourTexture —— 纹理采样器（sampler2D 类型）
 *   在 C++ 中通过 setInt("ourTexture", 0) 指定纹理单元
 *
 * ============================================================
 *  核心函数
 * ============================================================
 * texture(sampler2D, vec2) -> vec4
 *   第一个参数：纹理采样器（绑定了哪个纹理）
 *   第二个参数：纹理坐标
 *   返回值：该坐标处的纹素颜色（RGBA）
 *
 * @version 330 core
 */
#version 330 core

out vec4 FragColor;

in vec2 TexCoord;

uniform sampler2D ourTexture;

void main()
{
    FragColor = texture(ourTexture, TexCoord);
}
