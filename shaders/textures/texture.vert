/**
 * 顶点着色器 —— 纹理章节
 *
 * ============================================================
 *  功能
 * ============================================================
 * 1. 接收顶点位置（aPos）和纹理坐标（aTexCoord）
 * 2. 把位置转换到裁剪空间（这里是正交投影，直接传递）
 * 3. 把纹理坐标传递给片段着色器（通过 out 变量）
 *
 * ============================================================
 *  输入（顶点属性）
 * ============================================================
 * layout (location = 0) aPos      —— 顶点位置（vec3）
 * layout (location = 1) aTexCoord —— 纹理坐标（vec2）
 *
 * ============================================================
 *  输出（传递给片段着色器）
 * ============================================================
 * TexCoord —— 纹理坐标，OpenGL 会自动在三角形面片上插值
 *
 * ============================================================
 *  纹理坐标说明
 * ============================================================
 * 范围：[0, 0]（左下） ~ [1, 1]（右上）
 * 超过范围的行为由 glTexParameteri 设置的包裹模式决定
 *
 * 顶点数据布局（5 个 float 一组）：
 *   [x y z] [u v]
 *   stride = 5 * sizeof(float)
 *   offset: position = 0, texcoord = 3 * sizeof(float)
 *
 * 矩形各顶点的纹理坐标：
 *   右上 (0.5,  0.5) → (1, 1)
 *   右下 (0.5, -0.5) → (1, 0)
 *   左下 (-0.5, -0.5) → (0, 0)
 *   左上 (-0.5,  0.5) → (0, 1)
 *
 * @version 330 core
 */
#version 330 core

layout (location = 0) in vec3 aPos;
layout (location = 1) in vec2 aTexCoord;

out vec2 TexCoord;

void main()
{
    gl_Position = vec4(aPos, 1.0);
    TexCoord = aTexCoord;
}
